      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "time() - container_start_time_seconds{name!=\"\"}", "legendFormat": "{{name}}", "refId": "A"}],
      "title": "Container Uptime",
